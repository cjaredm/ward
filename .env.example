# Copy to .env.local and fill in. Never commit the filled-in file.

# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=

# Neon DIRECT connection string (no "-pooler"). Used ONLY by scripts/ —
# migrations, boundary seed and parcel import need session state and multi-statement
# DDL, which the pooled endpoint does not support.
DATABASE_URL_UNPOOLED=

# Base64-encoded bcrypt hash of the shared ward password. Generate with:
#   npm run hash-password -- 'your shared password'
# Paste the printed value exactly — no quotes, no escaping.
#
# It is base64 rather than a raw bcrypt hash because Next.js runs dotenv-expand
# over .env files: a raw hash starts with $2b$12$, those read as variable
# references, and the value silently truncates. Every login then fails with
# "Incorrect password" while the password itself is fine.
#
# Never keep the plaintext password in this file, including in a comment.
WARD_APP_PASSWORD_HASH=

# 32+ random bytes. The hash-password script prints one for you, or:
#   openssl rand -base64 32
AUTH_JWT_SECRET=

NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
PARCEL_SERVICE_URL=https://services1.arcgis.com/99lidPhWCzftIe9K/ArcGIS/rest/services/Parcels_Washington/FeatureServer/0
